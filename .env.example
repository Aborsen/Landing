# Copy to .env.local and fill in. .env* is git-ignored (except this example).
#
# Zoho "Request a connector" form submission endpoint — the full .../records URL.
# Required by POST /api/request-connector; without it the endpoint answers 503
# and the form shows its email fallback instead of pretending to succeed.
#
# Deliberately NOT prefixed with VITE_: prefixed variables are inlined into the
# client bundle. This one must stay server-side, because the endpoint it points
# at accepts unauthenticated writes from anyone who knows the URL.
#
# This is a RUNTIME secret, read when a request arrives — not a build input. It
# belongs in the environment of whatever serves /api/request-connector, which is
# not the same place as CI:
#   Vercel        Project -> Settings -> Environment Variables (Production + Preview)
#   own server    the systemd unit / Docker env / k8s secret for the Node process
#   CF Workers    wrangler secret put ZOHO_CONNECTOR_FORM_URL
# A GitLab CI/CD variable is the wrong home unless the pipeline itself injects it
# into a runtime environment — and note GitLab's masking rules reject some URL
# characters, so a masked variable may not accept this value verbatim.
ZOHO_CONNECTOR_FORM_URL=

# Zoho "Contact Support" form submission endpoint — the full .../records URL.
# Required by POST /api/contact-support. Same reasoning as above: unauthenticated
# write endpoint, so it stays server-side.
ZOHO_SUPPORT_FORM_URL=

# Zoho "Contact Sales" form submission endpoint — the full .../records URL.
# Required by POST /api/contact-sales.
ZOHO_SALES_FORM_URL=

# Zoho "Waitlist" form submission endpoint — the full .../records URL.
# Required by POST /api/waitlist (the email capture on /auth/sign-in).
ZOHO_WAITLIST_FORM_URL=

# Optional. Extra hostnames allowed to post to the endpoint, comma-separated.
# insightis.ai (with subdomains), localhost and *.vercel.app are always allowed;
# add whatever domain the site is served from after the migration.
# ALLOWED_FORM_ORIGINS=staging.insightis.ai,insightis.devart.com
